<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{displayName}} (@{{username}}) | Chitter</title>
    <meta name="description" content="{{desc}}" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://chitter.cjason.dev/u/{{username}}" />
    <meta property="og:title" content="{{displayName}} (@{{username}}) on Chitter" />
    <meta property="og:description" content="{{desc}}" />
    <meta property="og:image" content="/{{avatar}}" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content="https://chitter.cjason.dev/u/{{username}}" />
    <meta name="twitter:title" content="{{displayName}} (@{{username}}) on Chitter" />
    <meta name="twitter:description" content="{{desc}}" />
    <meta name="twitter:image" content="/{{avatar}}" />

    <link rel="shortcut icon" href="/assets/img/favicon.png" />
    <link rel="stylesheet" href="/assets/stylesBundle.css" />
  </head>
  <body class="antialiased">
    <div id="root"></div>
    <script src="/assets/profileBundle.js"></script>
  </body>
</html>